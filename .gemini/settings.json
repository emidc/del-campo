{
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "protect-paths",
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/protect-paths.mjs\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
