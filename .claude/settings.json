{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.claude/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./.codex/**)",
      "Edit(./.gemini/**)",
      "Edit(./.agents/**)",
      "Edit(./scripts/check-*.mjs)",
      "Edit(./scripts/guard-db-tests.mjs)",
      "Write(./.claude/**)",
      "Write(./.github/workflows/**)",
      "Write(./.codex/**)",
      "Write(./.gemini/**)",
      "Write(./.agents/**)",
      "Write(./scripts/check-*.mjs)",
      "Write(./scripts/guard-db-tests.mjs)",
      "Bash(git push --force *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
